{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nais.local/contracts/events/p0_events.schema.json",
  "title": "NAIS P0 Domain Events",
  "description": "Envelope + per-event payload. Owner: Agent 0. event_type suffix .vN is the payload version; breaking change => new version, old one kept for one release.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "producer",
    "correlation_id",
    "actor",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "enum": [
        "identity",
        "project",
        "catalog",
        "governance",
        "readiness",
        "audit",
        "platform"
      ]
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "user_id",
        "organization_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "USER",
            "SYSTEM"
          ]
        },
        "user_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "organization_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "payload": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "title": "identity.organization.created.v1",
      "description": "Organization registered.",
      "type": "object",
      "properties": {
        "event_type": {
          "const": "identity.organization.created.v1"
        },
        "producer": {
          "const": "identity"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "organization_id",
            "code",
            "name",
            "type"
          ],
          "properties": {
            "organization_id": {
              "type": "string",
              "format": "uuid"
            },
            "code": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "RESEARCH_INSTITUTE",
                "UNIVERSITY",
                "COMPANY",
                "PLATFORM_OPERATOR"
              ]
            }
          }
        }
      }
    },
