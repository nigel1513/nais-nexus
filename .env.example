NAIS_PUBLIC_BASE_URL=http://localhost:21051
NAIS_GATEWAY_PORT=21051
# Public IP/host of the dev server. Set the real value only in your local .env (never commit it).
NAIS_EXTERNAL_HOST=localhost

# API / worker (runtime role; migrations use MIGRATION_DATABASE_URL, D-027)
DATABASE_URL=postgresql+psycopg://nais_app:nais@postgres:5432/nais
MIGRATION_DATABASE_URL=postgresql+psycopg://nais_migrator:nais@postgres:5432/nais
POSTGRES_USER=nais
POSTGRES_PASSWORD=nais
REDIS_URL=redis://nais:nais@redis:6379/0
OPENSEARCH_URL=http://opensearch:9200
OPA_URL=http://opa:8181
OPA_TIMEOUT_MS=500
OIDC_ISSUER=http://localhost:21051/auth/realms/nais
OIDC_INTERNAL_JWKS_URL=http://keycloak:8080/auth/realms/nais/protocol/openid-connect/certs
OIDC_AUDIENCE=nais-api
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="NAIS AI-OS <no-reply@nais.local>"
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_RETENTION_DAYS=180
SMTP_TIMEOUT_SECONDS=10
AUDIT_ALLOW_FAKE_PORTS=false
LOG_LEVEL=INFO
KEYCLOAK_ADMIN_USER=nais
KEYCLOAK_ADMIN_PASSWORD=nais
# M01 transferUserOrganization updates the Keycloak org_code attribute (admin REST, master realm admin-cli).
KEYCLOAK_ADMIN_URL=http://keycloak:8080/auth

# Storage: org code -> STORAGE_<CODE>_* (D-024). Dev storage is SeaweedFS (D-034).
STORAGE_ORG_CODES=nais,inst-a,inst-b
STORAGE_INST_A_ENDPOINT=http://storage-a:8333
STORAGE_INST_A_BUCKET=nais-inst-a
STORAGE_INST_A_ACCESS_KEY=nais
STORAGE_INST_A_SECRET_KEY=nais
STORAGE_INST_B_ENDPOINT=http://storage-b:8333
STORAGE_INST_B_BUCKET=nais-inst-b
STORAGE_INST_B_ACCESS_KEY=nais
STORAGE_INST_B_SECRET_KEY=nais
STORAGE_NAIS_ENDPOINT=http://storage-a:8333
STORAGE_NAIS_BUCKET=nais-platform
STORAGE_NAIS_ACCESS_KEY=nais
STORAGE_NAIS_SECRET_KEY=nais
STORAGE_PRESIGN_TTL_SECONDS=300
STORAGE_MULTIPART_THRESHOLD_BYTES=67108864

# Modules (Wave 1; values equal the code defaults, so every key is optional)
PROJECT_MAX_MEMBERS=200
UPLOAD_URL_TTL_SECONDS=3600
UPLOAD_SESSION_TTL_SECONDS=3600
CATALOG_SYNC_VERIFY_MAX_BYTES=268435456
CATALOG_INDEX_ALIAS=nais-datasets
MALWARE_SCANNER=noop
READINESS_RUN_TIMEOUT_SECONDS=1800
READINESS_FILE_TIMEOUT_SECONDS=600
READINESS_WORKER_CONCURRENCY=2
# M13 workspace recipe runs (dedicated worker queue `workspace`; each run holds its inputs in memory)
WORKSPACE_MAX_ROWS=5000000
WORKSPACE_MAX_INPUT_BYTES=1073741824
WORKSPACE_RUN_TIMEOUT_SECONDS=1800
WORKSPACE_WORKER_CONCURRENCY=1

# Web (Agent 7, D-026)
AUTH_URL=http://localhost:21051/web-auth
AUTH_SECRET=change-me-32-bytes
AUTH_KEYCLOAK_ISSUER=http://localhost:21051/auth/realms/nais
AUTH_KEYCLOAK_INTERNAL_URL=http://keycloak:8080/auth/realms/nais
AUTH_KEYCLOAK_ID=nais-web
NEXT_PUBLIC_API_BASE=/api/v1
API_INTERNAL_BASE=http://api:8000/api/v1
NEXT_PUBLIC_API_MOCKING=disabled
AUTH_TRUST_HOST=true
# Extra hosts (host:port, comma-separated) the web app may be reached on, in addition to AUTH_URL / NAIS_EXTERNAL_HOST.
AUTH_ALLOWED_HOSTS=localhost:21051
# Web portal uses its in-app mock API until Wave 2 (build-time switch: rebuild `web` after changing).
# Web portal mode for docker compose (build arg + runtime). Wave 1 = mock API + demo login; real mode needs M04 (Wave 2).
WEB_API_MOCKING=enabled

# Platform LLM (optional; GPU shared with another platform, chat calls serialized in-process).
# Embedding / rerank are available only when NAIS_LLM_ENABLED=true AND their base URL is set.
NAIS_LLM_ENABLED=false
NAIS_LLM_BASE_URL=http://192.168.0.2:8001
NAIS_LLM_MODEL=llm
NAIS_LLM_TIMEOUT_S=60
NAIS_EMBED_BASE_URL=http://192.168.0.2:8002
NAIS_EMBED_MODEL=bge-m3
NAIS_RERANK_BASE_URL=http://192.168.0.2:8003
NAIS_RERANK_MODEL=bge-reranker
# Research-note search: request-path limit (seconds) for the query embedding and the rerank, each
NAIS_SEARCH_TIMEOUT_S=5
